---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Toast from '../components/Toast.astro'

interface Props {
  title: string
  description?: string
  lang: string
  footerContent: any
}

const base = import.meta.env.BASE_URL
const {
  title,
  description = 'GoRehab - Interactive therapy with the DextEgg System for hand rehabilitation.',
  lang,
  footerContent,
} = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="theme-color" content="#ed3350" />

    <link rel="preload" href={`${base}images/hero-bg.svg`} as="image" />
    <link rel="preload" href={`${base}fonts/BeatriceTRIAL-Regular.otf`} as="font" type="font/opentype" crossorigin />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="GoRehab" />

    <!-- Self-hosted Beatrice font -->
    <style
      is:inline
      set:html={`
      @font-face {
        font-family: 'Beatrice';
        src: url('${base}fonts/BeatriceTRIAL-Regular.otf') format('opentype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Beatrice';
        src: url('${base}fonts/BeatriceTRIAL-Bold.otf') format('opentype');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
    `}
    ></style>

    <title>{title}</title>
  </head>
  <body class="font-sans text-black antialiased">
    <div class="flex min-h-screen flex-col">
      <Header lang={lang} />
      <main class="flex-grow">
        <slot />
      </main>
      <Footer content={footerContent} lang={lang} />
    </div>
    <Toast />
  </body>
</html>
