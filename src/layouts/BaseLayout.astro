---
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import Toast from '../components/Toast.astro'
import type { FooterContent, Locale } from '../lib/i18n'

interface Props {
  title: string
  description?: string
  lang: Locale
  footerContent: FooterContent
}

const base = import.meta.env.BASE_URL
const site = 'https://leantrace.github.io'
const { title, description, lang, footerContent } = Astro.props
const desc = description ?? 'GoRehab - Interactive hand rehabilitation therapy'
const canonicalUrl = `${site}${base}${lang}/`
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={desc} />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <meta name="theme-color" content="#ed3350" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={`${site}${base}en/`} />
    <link rel="alternate" hreflang="de" href={`${site}${base}de/`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${base}en/`} />

    <link rel="preload" href={`${base}images/hero-bg.svg`} as="image" />
    <link rel="preload" href={`${base}fonts/BeatriceTRIAL-Regular.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}fonts/BeatriceTRIAL-Bold.woff2`} as="font" type="font/woff2" crossorigin />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />
    </noscript>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:site_name" content="GoRehab" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:image" content={`${site}${base}images/logo/logo.webp`} />

    <!-- Self-hosted Beatrice font -->
    <style
      is:inline
      set:html={`
      @font-face {
        font-family: 'Beatrice';
        src: url('${base}fonts/BeatriceTRIAL-Regular.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Beatrice';
        src: url('${base}fonts/BeatriceTRIAL-Bold.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
    `}
    ></style>

    <title>{title}</title>
  </head>
  <body class="text-headText font-sans antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-4">
      {lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}
    </a>
    <div class="flex min-h-screen flex-col">
      <Header lang={lang} />
      <main id="main-content" class="flex-grow">
        <slot />
      </main>
      <Footer content={footerContent} lang={lang} />
    </div>
    <Toast />
  </body>
</html>
