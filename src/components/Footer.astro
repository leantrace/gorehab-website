---
import type { FooterContent, Locale } from '../lib/i18n'

interface Props {
  content: FooterContent
  lang: Locale
}

const { content, lang } = Astro.props
const base = import.meta.env.BASE_URL
const buildNumber = import.meta.env.PUBLIC_BUILD_NUMBER || '0'
---

<footer id="newsletter" class="bg-footer-bg relative overflow-hidden px-4 pt-10 pb-10 md:pt-16 md:pb-16 lg:pt-20">
  <img
    class="absolute top-0 left-0 max-sm:-ml-24 max-sm:size-[200px]"
    src={`${base}images/footer-union.svg`}
    alt=""
    role="presentation"
    width="240"
    height="240"
    loading="lazy"
    decoding="async"
  />

  <div class="relative container mx-auto">
    <div class="mx-auto max-w-[1230px]">
      <div class="border-green grid grid-cols-12 gap-8 border-b pb-10 md:pb-16 lg:pb-28">
        <!-- Logo -->
        <div class="col-span-12 lg:col-span-3 xl:col-span-3">
          <a href={`${base}${lang}/`}>
            <img
              class="w-40"
              src={`${base}images/logo/logo.webp`}
              srcset={`${base}images/logo/logo-sm.webp 320w, ${base}images/logo/logo.webp 560w`}
              sizes="160px"
              alt="GoRehab Logo"
              width="560"
              height="177"
              loading="lazy"
              decoding="async"
            />
          </a>
        </div>

        <!-- Company Links -->
        <div class="col-span-12 md:col-span-6 lg:col-span-3 xl:col-span-2">
          <h2 class="text-green-light mb-5 text-base font-bold capitalize">
            {content.company_title}
          </h2>
          <ul class="space-y-3">
            <li>
              <a
                class="text-footer-text text-base font-normal"
                href="https://www.linkedin.com/company/gorehab"
                target="_blank"
                rel="noopener noreferrer"
              >
                {content.linkedin} <span class="sr-only">(opens in new tab)</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Newsletter -->
        <div class="col-span-12 lg:col-span-4 xl:col-span-5">
          <h2 class="text-green-light mb-5 font-bold">
            {content.newsletter_title}
          </h2>
          <label class="text-footer-text mb-3 text-base font-normal" for="email_footer">
            {content.email_label}
          </label>

          <form
            id="footer-newsletter-form"
            class="mt-2 flex"
            data-success={content.alert_success}
            data-error-email={content.alert_invalid_email}
            data-error-generic={content.alert_error}
          >
            <input
              type="email"
              id="email_footer"
              name="email_from"
              required
              placeholder={content.email_placeholder}
              class="text-footer-text focus:ring-green w-full max-w-[180px] rounded-lg border border-[#387AE7] bg-[#4F5A68] p-2 placeholder:text-[#77808B] focus:ring focus:outline-none md:max-w-[320px] md:p-4"
            />
            <button
              type="submit"
              class="bg-green ml-2 w-24 rounded-md px-2 py-2 text-sm font-medium text-white transition-opacity hover:opacity-90 disabled:cursor-not-allowed disabled:opacity-50 sm:w-40 md:ml-4 md:px-4"
            >
              {content.subscribe_btn}
            </button>
          </form>
        </div>
      </div>

      <!-- Bottom row -->
      <div class="flex flex-col-reverse pt-8 max-md:items-center max-md:gap-4 lg:grid lg:grid-cols-12">
        <div class="mt-4 flex items-center md:flex-row lg:col-span-3 xl:col-span-5">
          <p class="text-footer-text text-base font-normal">
            {content.copyright}{' '}
          </p>
          <img
            width="560"
            height="177"
            class="w-20"
            src={`${base}images/logo/logo.webp`}
            alt="GoRehab Logo"
            loading="lazy"
            decoding="async"
          />
          <span class="text-footer-text ml-2 text-[10px]">(v1.0.{buildNumber})</span>
        </div>

        <div class="flex w-full flex-col md:flex-row lg:col-span-9 lg:justify-end xl:col-span-7">
          <div class="flex items-start">
            <img
              class="mr-3"
              src={`${base}images/icons/location_on.svg`}
              alt="Location"
              width="30"
              height="30"
              loading="lazy"
              decoding="async"
            />
            <p class="text-footer-text w-[80%] text-base font-normal">
              {content.address}
            </p>
          </div>

          <div class="mt-3 flex items-start md:mt-0 md:ml-5">
            <img class="mr-3" src={`${base}images/icons/email.svg`} alt="Email" width="30" height="30" loading="lazy" decoding="async" />
            <a class="text-footer-text text-base font-normal" href="mailto:info@gorehab.ch"> info@gorehab.ch </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  import { handleNewsletterSubmit } from '../lib/emailjs'

  handleNewsletterSubmit('footer-newsletter-form')
</script>
