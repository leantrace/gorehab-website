---
import type { ContactContent } from '../lib/i18n'

interface Props {
  content: ContactContent
}

const { content } = Astro.props
---

<section id="contact" class="bg-surface relative py-12 md:py-16 lg:py-24">
  <div class="container mx-auto px-4">
    <h2
      class="font-beatrice text-headText mx-auto mb-6 max-w-xl text-center text-2xl leading-[1.3] font-semibold sm:text-3xl md:text-[44px]"
    >
      {content.title}
    </h2>
    <div class="mx-auto max-w-[800px]">
      <form
        id="contact-form"
        data-success={content.alert_success}
        data-error-email={content.alert_invalid_email}
        data-error-generic={content.alert_error}
      >
        <div class="grid grid-cols-12 gap-5 md:gap-10">
          <div class="col-span-12 md:col-span-6">
            <label class="text-headText mb-2 block text-sm font-medium sm:text-lg md:text-xl lg:text-2xl" for="fname">
              {content.label_name}
            </label>
            <input
              class="border-muted text-muted w-full rounded-lg border p-3 text-sm font-normal outline-0 sm:p-4 sm:text-lg"
              id="fname"
              name="fname"
              type="text"
              required
              minlength="2"
              maxlength="100"
              placeholder={content.placeholder_name}
            />
          </div>
          <div class="col-span-12 md:col-span-6">
            <label class="text-headText mb-2 block text-sm font-medium sm:text-lg md:text-xl lg:text-2xl" for="contact-email">
              {content.label_email}
            </label>
            <input
              class="border-muted text-muted w-full rounded-lg border p-3 text-sm font-normal outline-0 sm:p-4 sm:text-lg"
              id="contact-email"
              name="email_from"
              type="email"
              required
              placeholder={content.placeholder_email}
            />
          </div>
        </div>

        <div class="mt-5">
          <label class="text-headText mb-2 block text-sm font-medium sm:text-lg md:text-xl lg:text-2xl" for="message">
            {content.label_message}
          </label>
          <textarea
            class="border-muted text-muted h-[150px] w-full resize-none rounded-lg border p-3 text-sm font-normal outline-0 sm:h-[200px] sm:p-4 sm:text-lg md:h-[250px] lg:h-[200px]"
            id="message"
            placeholder={content.placeholder_message}
            required
            maxlength="2000"
            name="message"></textarea>
        </div>

        <!-- Honeypot field — hidden from humans, traps bots -->
        <input type="text" name="website_url" autocomplete="off" tabindex="-1" class="!absolute !-left-[9999px] !h-0 !w-0 !overflow-hidden" />

        <button
          type="submit"
          class="bg-green hover:bg-green-hover mt-5 w-full rounded-lg py-3 text-sm font-bold text-white transition-colors disabled:cursor-not-allowed disabled:opacity-50 sm:mt-6 sm:text-lg md:mt-10 md:py-4"
        >
          {content.button}
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  import { EMAIL_REGEX, emailjs, ensureInit, isHoneypotFilled, isRateLimited, markSubmitted } from '../lib/emailjs'

  function initContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null
    if (!form) return

    const successMsg = form.dataset.success || 'Sent!'
    const errorEmailMsg = form.dataset.errorEmail || 'Invalid email.'
    const errorGenericMsg = form.dataset.errorGeneric || 'Something went wrong'

    ensureInit()

    form.addEventListener('submit', async (e) => {
      e.preventDefault()

      if (isHoneypotFilled(form) || isRateLimited('contact-form')) return

      const emailInput = form.querySelector('input[name="email_from"]') as HTMLInputElement
      const btn = form.querySelector('button') as HTMLButtonElement
      const email = emailInput?.value?.trim()

      if (!email || !EMAIL_REGEX.test(email)) {
        window.showToast(errorEmailMsg, 'error')
        return
      }

      const originalText = btn.textContent
      btn.disabled = true
      btn.textContent = '...'

      try {
        await emailjs.sendForm(import.meta.env.PUBLIC_EMAILJS_SERVICE_ID, import.meta.env.PUBLIC_EMAILJS_TEMPLATE_ID, form)

        markSubmitted('contact-form')
        window.showToast(successMsg, 'success')
        form.reset()
      } catch (err: unknown) {
        const msg = err instanceof Error ? err.message : errorGenericMsg
        window.showToast(msg, 'error')
      } finally {
        btn.disabled = false
        btn.textContent = originalText
      }
    })
  }

  initContactForm()
</script>
