---
interface Props {
  content: any
}

const { content } = Astro.props
const base = import.meta.env.BASE_URL
---

<section class="relative px-4 py-12 sm:py-16">
  <img
    class="absolute top-10 -right-24 -z-1 w-[200px] sm:top-12 sm:right-0 md:top-16 md:w-[350px] lg:top-20"
    src={`${base}images/right.svg`}
    alt="decoration"
    width="400"
    height="400"
    loading="lazy"
    decoding="async"
  />
  <div class="relative container mx-auto">
    <div class="text-center">
      <h2 class="font-beatrice text-headText text-2xl leading-[1.3] font-normal sm:text-3xl md:text-[44px]">
        {content.title}
      </h2>

      <div class="mx-auto mb-12 max-w-4xl sm:mb-16 md:mb-18 lg:mb-22">
        <p class="mt-2 mb-6 text-sm leading-normal font-light text-[#757575] md:text-lg">
          {content.description_1}
        </p>
        <p class="mt-2 mb-6 text-sm leading-normal font-light text-[#757575] md:text-lg">
          {content.description_2}
        </p>
      </div>
    </div>

    <!-- Scroll-snap carousel with navigation -->
    <div class="relative mx-auto w-full max-w-4xl">
      <!-- Left arrow -->
      <button
        id="team-prev"
        class="absolute top-1/3 -left-2 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#4a7c62] shadow-lg transition-opacity hover:bg-[#EFFAF4] md:-left-5"
        aria-label="Previous team member"
      >
        &#8249;
      </button>

      <!-- Right arrow -->
      <button
        id="team-next"
        class="absolute top-1/3 -right-2 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#4a7c62] shadow-lg transition-opacity hover:bg-[#EFFAF4] md:-right-5"
        aria-label="Next team member"
      >
        &#8250;
      </button>

      <div class="overflow-hidden px-4">
        <div id="team-carousel" class="team-carousel flex snap-x snap-mandatory gap-8 overflow-x-auto pb-8">
          {
            content.team &&
              content.team.map((member: { name: string; role: string; image: string }) => (
                <div class="w-[260px] flex-shrink-0 snap-center">
                  <div class="flex flex-col items-center text-center">
                    <img
                      class="mx-auto h-60 w-60 rounded-full object-cover"
                      src={`${base}${member.image.replace(/^\//, '')}`}
                      alt={member.name}
                      width="240"
                      height="240"
                      loading="lazy"
                      decoding="async"
                    />
                    <h3 class="mt-4 text-base font-semibold text-[#4a7c62] sm:text-lg md:mt-5 md:text-xl">{member.name}</h3>
                    <p class="mt-1 text-base font-normal text-[#757575] sm:text-lg md:text-xl">{member.role}</p>
                  </div>
                </div>
              ))
          }
        </div>
      </div>

      <!-- Dot indicators -->
      <div id="team-dots" class="mt-4 flex justify-center gap-2"></div>
    </div>
  </div>
</section>

<style>
  .team-carousel {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .team-carousel::-webkit-scrollbar {
    display: none;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background-color: #d1d5db;
    transition: all 0.3s;
  }
  .dot.active {
    width: 35px;
    background-color: #4a7c62;
  }
</style>

<script>
  function initTeamCarousel() {
    const carousel = document.getElementById('team-carousel')
    const prevBtn = document.getElementById('team-prev')
    const nextBtn = document.getElementById('team-next')
    const dotsContainer = document.getElementById('team-dots')
    if (!carousel || !prevBtn || !nextBtn || !dotsContainer) return

    const items = carousel.querySelectorAll<HTMLElement>(':scope > div')
    const itemCount = items.length
    if (itemCount === 0) return

    // Calculate visible count based on container width
    function getVisibleCount(): number {
      const containerWidth = carousel!.clientWidth
      // Each item is 260px + 32px gap
      return Math.max(1, Math.floor((containerWidth + 32) / (260 + 32)))
    }

    // Build dots
    function buildDots() {
      dotsContainer!.innerHTML = ''
      const pageCount = Math.max(1, itemCount - getVisibleCount() + 1)
      for (let i = 0; i < pageCount; i++) {
        const dot = document.createElement('button')
        dot.className = 'dot'
        dot.setAttribute('aria-label', `Go to slide ${i + 1}`)
        dot.addEventListener('click', () => scrollToIndex(i))
        dotsContainer!.appendChild(dot)
      }
      updateDots()
    }

    function getCurrentIndex(): number {
      const scrollLeft = carousel!.scrollLeft
      const itemWidth = 260 + 32 // item + gap
      return Math.round(scrollLeft / itemWidth)
    }

    function updateDots() {
      const current = getCurrentIndex()
      const dots = dotsContainer!.querySelectorAll('.dot')
      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === current)
      })
    }

    function scrollToIndex(index: number) {
      const itemWidth = 260 + 32
      carousel!.scrollTo({ left: index * itemWidth, behavior: 'smooth' })
    }

    prevBtn.addEventListener('click', () => {
      const current = getCurrentIndex()
      scrollToIndex(Math.max(0, current - 1))
    })

    nextBtn.addEventListener('click', () => {
      const current = getCurrentIndex()
      const maxIndex = itemCount - getVisibleCount()
      scrollToIndex(Math.min(maxIndex, current + 1))
    })

    carousel.addEventListener('scroll', updateDots)

    buildDots()
    window.addEventListener('resize', buildDots)
  }

  document.addEventListener('astro:page-load', initTeamCarousel)
  initTeamCarousel()
</script>
