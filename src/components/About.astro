---
import type { AboutContent } from '../lib/i18n'

interface Props {
  content: AboutContent
}

const { content } = Astro.props
const base = import.meta.env.BASE_URL
---

<section class="relative px-4 py-12 sm:py-16">
  <img
    class="absolute top-10 -right-24 -z-1 w-[200px] sm:top-12 sm:right-0 md:top-16 md:w-[350px] lg:top-20"
    src={`${base}images/right.svg`}
    alt=""
    role="presentation"
    width="400"
    height="400"
    loading="lazy"
    decoding="async"
  />
  <div class="relative container mx-auto">
    <div class="text-center">
      <h2 class="font-beatrice text-headText text-2xl leading-[1.3] font-normal sm:text-3xl md:text-[44px]">
        {content.title}
      </h2>

      <div class="mx-auto mb-12 max-w-4xl sm:mb-16 md:mb-18 lg:mb-22">
        <p class="text-body mt-2 mb-6 text-sm leading-normal font-light md:text-lg">
          {content.description_1}
        </p>
        <p class="text-body mt-2 mb-6 text-sm leading-normal font-light md:text-lg">
          {content.description_2}
        </p>
      </div>
    </div>

    <!-- Scroll-snap carousel with navigation -->
    <div class="relative mx-auto w-full max-w-4xl">
      <!-- Left arrow -->
      <button
        id="team-prev"
        class="text-green hover:bg-green-bg absolute top-1/3 -left-2 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white shadow-lg transition-opacity md:-left-5"
        aria-label="Previous team member"
      >
        &#8249;
      </button>

      <!-- Right arrow -->
      <button
        id="team-next"
        class="text-green hover:bg-green-bg absolute top-1/3 -right-2 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-white shadow-lg transition-opacity md:-right-5"
        aria-label="Next team member"
      >
        &#8250;
      </button>

      <div class="overflow-hidden px-4">
        <div id="team-carousel" class="team-carousel flex snap-x snap-mandatory gap-8 overflow-x-auto pb-8">
          {
            content.team &&
              content.team.map((member: { name: string; role: string; image: string }) => (
                <div class="w-[260px] shrink-0 snap-center">
                  <div class="flex flex-col items-center text-center">
                    <img
                      class="mx-auto h-60 w-60 rounded-full object-cover"
                      src={`${base}${member.image}`}
                      srcset={`${base}${member.image.replace('.webp', '-sm.webp')} 260w, ${base}${member.image} 480w`}
                      sizes="240px"
                      alt={member.name}
                      width="240"
                      height="240"
                      loading="lazy"
                      decoding="async"
                    />
                    <h3 class="text-green mt-4 text-base font-semibold sm:text-lg md:mt-5 md:text-xl">{member.name}</h3>
                    <p class="text-body mt-1 text-base font-normal sm:text-lg md:text-xl">{member.role}</p>
                  </div>
                </div>
              ))
          }
        </div>
      </div>

      <!-- Dot indicators -->
      <div id="team-dots" class="mt-4 flex justify-center gap-2"></div>
    </div>
  </div>
</section>

<style>
  .team-carousel {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .team-carousel::-webkit-scrollbar {
    display: none;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background-color: #d1d5db;
    transition: all 0.3s;
  }
  .dot.active {
    width: 35px;
    background-color: #4a7c62;
  }
</style>

<script>
  function initTeamCarousel() {
    const carousel = document.getElementById('team-carousel')
    const prevBtn = document.getElementById('team-prev')
    const nextBtn = document.getElementById('team-next')
    const dotsContainer = document.getElementById('team-dots')
    if (!carousel || !prevBtn || !nextBtn || !dotsContainer) return

    const items = carousel.querySelectorAll<HTMLElement>(':scope > div')
    const itemCount = items.length
    if (itemCount === 0) return

    const ITEM_WIDTH = 260 + 32

    function getVisibleCount(): number {
      return Math.max(1, Math.floor((carousel!.clientWidth + 32) / ITEM_WIDTH))
    }

    function getCurrentIndex(): number {
      return Math.round(carousel!.scrollLeft / ITEM_WIDTH)
    }

    function buildDots() {
      const visibleCount = getVisibleCount()
      const scrollLeft = carousel!.scrollLeft
      const current = Math.round(scrollLeft / ITEM_WIDTH)
      const pageCount = Math.max(1, itemCount - visibleCount + 1)

      requestAnimationFrame(() => {
        dotsContainer!.innerHTML = ''
        const fragment = document.createDocumentFragment()
        for (let i = 0; i < pageCount; i++) {
          const dot = document.createElement('button')
          dot.className = i === current ? 'dot active' : 'dot'
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`)
          dot.addEventListener('click', () => scrollToIndex(i))
          fragment.appendChild(dot)
        }
        dotsContainer!.appendChild(fragment)
      })
    }

    function updateDots() {
      const current = getCurrentIndex()
      requestAnimationFrame(() => {
        const dots = dotsContainer!.querySelectorAll('.dot')
        dots.forEach((dot, i) => {
          dot.classList.toggle('active', i === current)
        })
      })
    }

    function scrollToIndex(index: number) {
      carousel!.scrollTo({ left: index * ITEM_WIDTH, behavior: 'smooth' })
    }

    prevBtn.addEventListener('click', () => {
      const current = getCurrentIndex()
      scrollToIndex(Math.max(0, current - 1))
    })

    nextBtn.addEventListener('click', () => {
      const current = getCurrentIndex()
      const maxIndex = itemCount - getVisibleCount()
      scrollToIndex(Math.min(maxIndex, current + 1))
    })

    let scrollTimer: ReturnType<typeof setTimeout>
    carousel.addEventListener('scroll', () => {
      clearTimeout(scrollTimer)
      scrollTimer = setTimeout(updateDots, 50)
    })

    buildDots()
    let resizeTimer: ReturnType<typeof setTimeout>
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer)
      resizeTimer = setTimeout(buildDots, 150)
    })
  }

  initTeamCarousel()
</script>
