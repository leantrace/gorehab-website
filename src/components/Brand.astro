---
interface Props {
  content: any
}

const { content } = Astro.props
const base = import.meta.env.BASE_URL

const brands = [
  { image: `${base}images/brand/b1.svg` },
  { image: `${base}images/brand/b2.svg` },
  { image: `${base}images/brand/b3.svg` },
  { image: `${base}images/brand/b4.svg` },
  { image: `${base}images/brand/b5.svg` },
  { image: `${base}images/brand/b8.webp` },
  { image: `${base}images/brand/b9.svg` },
]
---

<div class="border-b-2 border-[#F3F3F3] pl-8">
  <h2 class="font-beatrice text-headText pt-8 text-center text-2xl leading-[1.3] font-normal sm:text-3xl md:text-[44px]">
    {content.title}
  </h2>
  <div class="container mx-auto">
    <div class="mx-auto max-w-[1230px]">
      <div class="w-full overflow-hidden pt-2 pb-12">
        <!-- CSS Marquee: logos rendered twice for seamless loop -->
        <div class="marquee-track flex" style="width: max-content;">
          {
            [...brands, ...brands].map((brand, i) => (
              <div class="mx-[15px] flex max-h-[200px] min-h-[100px] w-[150px] flex-shrink-0 items-center justify-center md:mx-[30px]">
                <img
                  class="h-auto max-h-[100px] w-auto"
                  src={brand.image}
                  alt="Partner logo"
                  width="150"
                  height="100"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>
