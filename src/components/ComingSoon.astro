---
import type { ComingSoonContent } from '../lib/i18n'

interface Props {
  content: ComingSoonContent
}

const { content } = Astro.props
const base = import.meta.env.BASE_URL
---

<section aria-labelledby="coming-soon-title" class="bg-green-bg relative z-1 overflow-x-clip px-4 py-12 md:py-16 lg:py-32">
  <img
    class="absolute bottom-0 -left-24 w-[200px] sm:left-0 md:w-[350px]"
    src={`${base}images/left.svg`}
    alt=""
    role="presentation"
    width="400"
    height="400"
    loading="lazy"
    decoding="async"
  />
  <div class="relative container mx-auto">
    <div class="mx-auto grid max-w-[1200px] grid-cols-1 items-center max-lg:gap-8 lg:grid-cols-2">
      <div>
        <h2 id="coming-soon-title" class="font-beatrice text-headText text-2xl leading-[1.3] font-normal sm:text-3xl md:text-[44px]">
          {content.title_start}{' '}
          <span class="text-green font-semibold">{content.title_highlight}</span>
        </h2>

        <p class="text-muted mt-2 mb-6 w-full text-sm leading-normal font-light md:text-lg lg:max-w-[430px]">
          {content.description}
        </p>

        <h3 class="text-headText text-xl font-normal md:text-2xl">
          {content.healthcare_title}
        </h3>
        <p class="text-muted mt-2 mb-6 w-full text-sm leading-normal font-light md:mb-8 md:text-lg lg:max-w-[430px]">
          {content.healthcare_desc}
        </p>

        <h3 class="text-headText mb-4 text-xl font-normal md:text-2xl">
          {content.join_title}
        </h3>

        <form
          id="coming-soon-form"
          class="flex w-full flex-col gap-3 sm:flex-row sm:gap-4 lg:max-w-[480px]"
          data-success={content.alert_success}
          data-error-email={content.alert_invalid_email}
          data-error-generic={content.alert_error}
        >
          <label for="coming-soon-email" class="sr-only">{content.placeholder}</label>
          <input
            class="border-muted text-muted placeholder:text-muted/70 w-full flex-1 rounded-lg border bg-transparent p-3 text-sm font-normal outline-0 sm:p-4 sm:text-lg"
            id="coming-soon-email"
            name="email_from"
            type="email"
            required
            placeholder={content.placeholder}
          />
          <button
            type="submit"
            class="bg-green hover:bg-green-hover w-full rounded-lg px-6 py-3 text-sm font-medium whitespace-nowrap text-white transition-colors disabled:cursor-not-allowed disabled:opacity-50 sm:w-auto sm:py-4 sm:text-base"
          >
            {content.button}
          </button>
        </form>
      </div>
      <div>
        <img
          class="-mb-8 w-full"
          width="594"
          height="340"
          src={`${base}images/cs.webp`}
          srcset={`${base}images/cs-sm.webp 420w, ${base}images/cs.webp 750w`}
          sizes="(max-width: 1024px) 100vw, 50vw"
          alt="Coming soon preview"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { handleNewsletterSubmit } from '../lib/emailjs'

  handleNewsletterSubmit('coming-soon-form')
</script>
