---
interface Props {
  content: any
}

const { content } = Astro.props
const base = import.meta.env.BASE_URL
---

<section class="relative z-1 overflow-x-clip bg-[#EFFAF4] px-4 py-12 md:py-16 lg:py-32">
  <img
    class="absolute bottom-0 -left-24 w-[200px] sm:left-0 md:w-[350px]"
    src={`${base}images/left.svg`}
    alt="decoration"
    width="400"
    height="400"
    loading="lazy"
    decoding="async"
  />
  <div class="relative container mx-auto">
    <div class="mx-auto grid max-w-[1200px] grid-cols-1 items-center max-lg:gap-8 lg:grid-cols-2">
      <div>
        <h2 class="font-beatrice text-headText text-2xl leading-[1.3] font-normal sm:text-3xl md:text-[44px]">
          {content.title_start}{' '}
          <span class="font-semibold text-[#699980]">{content.title_highlight}</span>
        </h2>

        <p class="mt-2 mb-6 w-full text-sm leading-normal font-light text-[#757575] md:text-lg lg:max-w-[430px]">
          {content.description}
        </p>

        <h5 class="text-headText text-xl font-normal md:text-2xl">
          {content.healthcare_title}
        </h5>
        <p class="mt-2 mb-6 w-full text-sm leading-normal font-light text-[#757575] md:mb-8 md:text-lg lg:max-w-[430px]">
          {content.healthcare_desc}
        </p>

        <h5 class="text-headText mb-4 text-xl font-normal md:text-2xl">
          {content.join_title}
        </h5>

        <form
          id="coming-soon-form"
          class="flex w-full flex-col gap-3 sm:flex-row sm:gap-4 lg:max-w-[480px]"
          data-success={content.alert_success}
          data-error-email={content.alert_invalid_email}
        >
          <input
            class="w-full flex-1 rounded-lg border border-[#757575] bg-transparent p-3 text-sm font-normal text-[#757575] outline-0 placeholder:text-[#757575]/70 sm:p-4 sm:text-lg"
            name="email_from"
            type="email"
            placeholder={content.placeholder}
          />
          <button
            type="submit"
            class="w-full rounded-lg bg-[#699980] px-6 py-3 text-sm font-medium whitespace-nowrap text-white transition-colors hover:bg-[#5a856f] sm:w-auto sm:py-4 sm:text-base"
          >
            {content.button}
          </button>
        </form>
      </div>
      <div>
        <img class="-mb-8 w-full" width="594" height="340" src={`${base}images/cs.webp`} alt="Coming soon preview" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

<script>
  import emailjs from '@emailjs/browser'

  const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/

  function initComingSoonForm() {
    const form = document.getElementById('coming-soon-form') as HTMLFormElement | null
    if (!form) return

    const successMsg = form.dataset.success || 'Thanks!'
    const errorEmailMsg = form.dataset.errorEmail || 'Invalid email.'

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const input = form.querySelector('input[name="email_from"]') as HTMLInputElement
      const btn = form.querySelector('button') as HTMLButtonElement
      const email = input?.value?.trim()

      if (!email || !EMAIL_REGEX.test(email)) {
        window.showToast(errorEmailMsg, 'error')
        return
      }

      const originalText = btn.textContent
      btn.disabled = true
      btn.textContent = '...'

      try {
        emailjs.init({
          publicKey: import.meta.env.PUBLIC_EMAILJS_PUBLIC_KEY,
          blockHeadless: true,
          limitRate: { id: 'comingsoon', throttle: 10000 },
        })

        await emailjs.send(import.meta.env.PUBLIC_EMAILJS_SERVICE_ID, import.meta.env.PUBLIC_EMAILJS_NEWSLETTER_TEMPLATE_ID, {
          email_from: email,
        })

        window.showToast(successMsg, 'success')
        input.value = ''
      } catch (err: unknown) {
        const msg = err instanceof Error ? err.message : 'Something went wrong'
        window.showToast('Error: ' + msg, 'error')
      } finally {
        btn.disabled = false
        btn.textContent = originalText
      }
    })
  }

  document.addEventListener('astro:page-load', initComingSoonForm)
  initComingSoonForm()
</script>
