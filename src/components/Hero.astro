---
import type { HeroContent } from '../lib/i18n'

interface Props {
  content: HeroContent
}

const { content } = Astro.props
const base = import.meta.env.BASE_URL
---

<section aria-label="Hero" class="relative px-4 pt-10 pb-14 sm:pt-12 sm:pb-16 md:pt-14 md:pb-28">
  <img
    src={`${base}images/hero-bg.svg`}
    class="absolute inset-0 h-full w-full object-cover object-bottom"
    alt=""
    role="presentation"
    width="1440"
    height="900"
    fetchpriority="high"
  />
  <div class="relative container mx-auto">
    <div class="mx-auto max-w-[1230px]">
      <div class="grid grid-cols-1 items-center max-lg:gap-12 lg:grid-cols-2">
        <!-- Left Column: Text -->
        <div class="pr-4 lg:pr-14">
          <h1 class="font-beatrice text-2xl leading-[1.3] font-normal text-white sm:text-3xl md:text-[40px]">
            {content.title_start}{' '}
            <span class="font-semibold">{content.title_highlight}</span>
            {content.title_end}
          </h1>
          <p class="mt-2 mb-4 text-sm leading-normal font-normal text-white sm:mb-8 md:text-lg">
            {content.description}
          </p>
          <div class="flex flex-row items-center pt-4">
            <a
              class="text-headText mr-4 w-full max-w-[200px] rounded-md border-2 border-[#BBCCC2] bg-[#BBCCC2] p-3 text-center text-sm font-bold sm:text-[15px]"
              href="#contact"
            >
              {content.btn_contact}
            </a>
            <a
              class="mr-2 w-full max-w-[200px] rounded-md border-2 border-white bg-transparent p-3 text-center text-sm font-bold text-white sm:text-[15px]"
              href="#newsletter"
            >
              {content.btn_newsletter}
            </a>
          </div>
        </div>

        <!-- Right Column: Floating Cards & Image -->
        <div class="relative min-h-[300px] sm:min-h-[400px]">
          <!-- Card 1: B2B -->
          <div
            class="relative -left-0 mb-2 w-full rounded-lg bg-[#f4eaeacc] px-4 py-2 sm:absolute sm:mb-0 sm:w-[245px] sm:py-3 lg:-left-[35px]"
          >
            <div class="flex items-center">
              <img src={`${base}images/icons/h1.webp`} width="30" height="30" alt="B2B icon" loading="lazy" />
              <div class="ml-4">
                <p class="text-sm font-bold text-muted">{content.card_b2b_title}</p>
                <p class="text-[11px] font-semibold text-[#545567]">{content.card_b2b_desc}</p>
              </div>
            </div>
          </div>

          <!-- Card 2: Congratulations -->
          <div
            class="relative top-0 right-0 mb-2 w-full rounded-lg bg-[#f4eaeacc] px-4 py-2 sm:absolute sm:top-0 sm:mb-0 sm:w-[220px] sm:py-3"
          >
            <div class="flex items-center">
              <img src={`${base}images/icons/h2.webp`} width="30" height="30" alt="Congratulations icon" loading="lazy" />
              <div class="ml-4">
                <p class="text-sm font-bold text-muted">{content.card_congrats_title}</p>
                <p class="text-[11px] font-semibold text-[#545567]">{content.card_congrats_desc}</p>
              </div>
            </div>
          </div>

          <img
            class="w-full"
            src={`${base}images/hero-right.webp`}
            srcset={`${base}images/hero-right-sm.webp 420w, ${base}images/hero-right.webp 552w`}
            sizes="(max-width: 1024px) 100vw, 50vw"
            alt="DextEgg Hero"
            width="650"
            height="410"
            fetchpriority="high"
          />

          <!-- Card 3: B2C -->
          <div class="relative right-0 bottom-0 mb-2 w-full rounded-lg bg-[#f4eaeacc] px-4 py-2 sm:absolute sm:mb-0 sm:w-[220px] sm:py-3">
            <div class="flex items-center">
              <img src={`${base}images/icons/h3.webp`} width="30" height="30" alt="B2C icon" loading="lazy" />
              <div class="ml-4">
                <p class="text-sm font-bold text-muted">{content.card_b2c_title}</p>
                <p class="text-[11px] font-semibold text-[#545567]">{content.card_b2c_desc}</p>
              </div>
            </div>
          </div>

          <!-- Card 4: Rehab Tech -->
          <div
            class="relative -left-0 z-1 mb-2 w-full rounded-lg bg-[#f4eaeacc] px-4 py-2 sm:absolute sm:bottom-[45px] sm:mb-0 sm:w-[235px] sm:py-3 lg:-left-[45px]"
          >
            <div class="flex items-start">
              <div class="relative">
                <img src={`${base}images/profile.webp`} width="30" height="30" alt="Profile" loading="lazy" />
                <div class="absolute right-0 bottom-0 h-[10px] w-[10px] rounded-full bg-red-500"></div>
              </div>
              <div class="ml-4">
                <p class="text-[12px] font-bold text-muted">{content.card_rehab_title}</p>
                <p class="text-[10px] font-semibold text-[#545567]">{content.card_rehab_time}</p>
                <p class="mt-1.5 inline-block rounded-full bg-green px-6 py-1.5 text-[10px] font-bold text-white sm:mt-3">
                  {content.card_rehab_btn}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
